{
  "$id": "cart",
  "title": "Cart",
  "description": "Response of GET /cart, POST /cart/items, and PATCH and DELETE /cart/items/:itemId.",
  "type": "object",
  "additionalProperties": false,
  "required": ["username", "items", "companyIds", "hasMixedCompanies", "totalItems", "totalCents"],
  "properties": {
    "username": { "type": "string", "pattern": "^[A-Za-z0-9_]{3,30}$" },
    "items": { "type": "array", "items": { "$ref": "#/definitions/item" } },
    "companyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "hasMixedCompanies": { "type": "boolean" },
    "totalItems": { "type": "integer", "minimum": 0 },
    "totalCents": { "type": "integer", "minimum": 0 }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "companyId",
        "companyName",
        "productId",
        "productName",
        "optionId",
        "optionLabel",
        "unitPriceCents",
        "quantity",
        "subtotalCents"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "companyId": { "type": "string", "minLength": 1 },
        "companyName": { "type": "string", "minLength": 1 },
        "productId": { "type": "string", "minLength": 1 },
        "productName": { "type": "string", "minLength": 1 },
        "optionId": { "type": "string", "enum": ["S", "M", "L", "R"] },
        "optionLabel": { "type": "string", "minLength": 1 },
        "unitPriceCents": { "type": "integer", "minimum": 1 },
        "quantity": { "type": "integer", "minimum": 1 },
        "subtotalCents": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
